# =============================================================================
# 掌中灵中继服务 — 环境变量
# =============================================================================
# 复制为 .env 后按需修改。.env 不要提交到版本库。
#
# 本文件的每一项都与 server/src/config.js 一一对应，
# 可用 `npm run env:check` 自动校验（改名或新增变量忘了同步会直接报错）。
#
# ⚠️ docker compose 的 env_file 不支持行内注释 ——
#    注释必须独占一行，否则会连同 `#` 后面的内容一起被当成变量值。
# =============================================================================


# ---------------------------------------------------------------- 基础

NODE_ENV=production

# 宿主机对外端口（Docker 部署时生效；容器内固定监听 8080）。
# App 端「服务器设置」里填写的端口必须与此一致。
# 默认 8111：部分服务器 8080 已被占用，故对外统一改走 8111。
APP_PORT=8111

# 服务监听地址（可选项，默认 0.0.0.0 即所有网卡）。
# Docker 部署时保持默认即可；仅宿主机直接运行且只想本机访问时改成 127.0.0.1。
#APP_HOST=0.0.0.0

# ★ 时区 —— 影响「额度日」的归日点，务必与被控端设备保持一致。
#
# 服务端（grants.js / usage.js）与被控端（DayKeys）都按**各自进程的本地时区**
# 计算 dayKey。容器默认是 UTC，若不设置，服务器与设备会相差 8 小时，
# 后果是整天错位：家长打开使用报告看到「今日用量 0」，加时授权落在错误的日子。
TZ=Asia/Shanghai

# 必填：JWT 签名密钥，至少 32 字符。
# 生成方式：openssl rand -hex 32
# ⚠️ 留空会导致服务拒绝启动 —— 空密钥等同于完全不做鉴权。
JWT_SECRET=


# ---------------------------------------------------------------- 数据落盘
# 全部位于容器内 /data 下，对应挂载卷 zzl-data。
# 改到 /data 之外会失去持久化，容器重建即丢数据。

DB_PATH=/data/app.db
UPLOAD_DIR=/data/uploads
SCREENSHOT_DIR=/data/screenshots


# ---------------------------------------------------------------- 令牌有效期

PARENT_TOKEN_TTL=30d
CHILD_TOKEN_TTL=3650d


# ---------------------------------------------------------------- 配对与在线状态

# 配对码有效期（分钟）
PAIR_CODE_TTL_MINUTES=5

# 超过该时长未收到心跳即判定设备离线（毫秒）
HEARTBEAT_TIMEOUT_MS=90000


# ---------------------------------------------------------------- 指令有效期
# 设备离线时指令会排队等待补发，超过下列时限即作废。
# 这些数值决定「补发的指令还算不算数」，是可按使用习惯调整的运营参数。

# 按需截屏：过期即无意义，所以很短
COMMAND_TTL_SCREENSHOT_SECONDS=60

# 解除锁定：防止「意外解锁」在很久之后才被补执行
COMMAND_TTL_CLEAR_LOCK_MINUTES=360

# 请求设备重新上报已安装应用清单
COMMAND_TTL_REQUEST_APPS_MINUTES=360


# ---------------------------------------------------------------- 临时授权默认有效期（分钟）
# 家长在控制端可逐次指定，这里是未指定时的默认值。

GRANT_TTL_TOTAL_ADD_MINUTES=720
GRANT_TTL_APP_ALLOW_MINUTES=120
GRANT_TTL_UNLOCK_MINUTES=60


# ---------------------------------------------------------------- 加时申请

# 审批时限：超过则自动作废，避免家长误批几小时前发来的请求
TIME_REQUEST_TTL_MINUTES=30

# 两次申请之间的最小间隔（分钟）
TIME_REQUEST_MIN_INTERVAL_MINUTES=10

# 每小时最多申请次数（防刷）
TIME_REQUEST_MAX_PER_HOUR=2

# 单次申请与批准的时长上限（分钟）
TIME_REQUEST_MAX_MINUTES=180


# ---------------------------------------------------------------- 截屏

# 单张图片的字节上限，超出直接拒绝，避免被单次上传撑爆磁盘
SCREENSHOT_MAX_BYTES=1048576

# 每台设备保留张数上限，超出后淘汰最旧的
SCREENSHOT_MAX_PER_DEVICE=60

# 保留天数
SCREENSHOT_RETENTION_DAYS=30


# ---------------------------------------------------------------- 离线密码
# 孩子在被控端输错密码的限流阈值

PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=10
